# =============================================================================
# DABA - CONFIGURATION ENVIRONNEMENT PRODUCTION
# =============================================================================
# Copiez ce fichier vers .env et remplissez les valeurs de production
# NE JAMAIS COMMITTER LE FICHIER .env !
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONNEMENT
# -----------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_URL=https://daba-api.onrender.com
FRONTEND_URL=https://daba.vercel.app

# -----------------------------------------------------------------------------
# BASE DE DONNÉES (Render PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=votre-db-host.render.com
DB_PORT=5432
DB_NAME=daba
DB_USER=votre-db-user
DB_PASSWORD=votre-db-password-securise

# SSL pour PostgreSQL (production)
# DATABASE_SSL_MODE=require

# -----------------------------------------------------------------------------
# SÉCURITÉ
# -----------------------------------------------------------------------------
# Clé secrète pour les tokens (générer avec: openssl rand -base64 64)
JWT_SECRET=GENERER_UNE_NOUVELLE_CLE_SECRETE_ICI_64_CARACTERES_MINIMUM

# Clé pour signer les URLs de paiement
PAYMENT_SECRET_KEY=GENERER_UNE_NOUVELLE_CLE_SECRETE_ICI

# Clé API pour les commandes externes (n8n/WhatsApp)
# Utilisée dans l'endpoint /api/orders/create_external.php via header X-API-Key
EXTERNAL_API_KEY=GENERER_UNE_CLE_API_SECRETE_ICI

# Durée de vie des tokens (en secondes)
ACCESS_TOKEN_EXPIRY=900
REFRESH_TOKEN_EXPIRY=2592000

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Origines autorisées (séparées par des virgules)
ALLOWED_ORIGINS=https://daba.vercel.app,https://www.daba.com,https://daba.com

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW=60

# -----------------------------------------------------------------------------
# STRIPE (Production)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_votre_cle_secrete_stripe
STRIPE_PUBLISHABLE_KEY=pk_live_votre_cle_publique_stripe
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret_stripe
STRIPE_WEBHOOK_ENDPOINT=https://daba-api.onrender.com/payment/stripe-webhook

# -----------------------------------------------------------------------------
# EMAIL (Production - SendGrid ou Mailgun)
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=SG.votre_cle_sendgrid
MAIL_FROM_ADDRESS=noreply@daba.com
MAIL_FROM_NAME="Daba"
MAIL_ENCRYPTION=tls

# -----------------------------------------------------------------------------
# STOCKAGE IMAGES (Cloudinary ou AWS S3)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
CLOUDINARY_UPLOAD_PRESET=votre_upload_preset

# Ou AWS S3
# AWS_ACCESS_KEY_ID=votre_access_key
# AWS_SECRET_ACCESS_KEY=votre_secret_key
# AWS_BUCKET=votre_bucket
# AWS_REGION=eu-west-3

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=warning
LOG_PATH=./logs

# -----------------------------------------------------------------------------
# SEO & ANALYTICS
# -----------------------------------------------------------------------------
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_SEARCH_CONSOLE_VERIFICATION=votre_verification_code
FACEBOOK_PIXEL_ID=votre_pixel_id

# -----------------------------------------------------------------------------
# LOCALISATION
# -----------------------------------------------------------------------------
DEFAULT_LOCALE=fr
DEFAULT_CURRENCY=XOF
DEFAULT_COUNTRY=BJ
TIMEZONE=Africa/Porto-Novo
