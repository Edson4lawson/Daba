# =============================================================================
# CONFIGURATION APACHE - DABA BACKEND
# =============================================================================

# Activer le rewriting
RewriteEngine On

# Rediriger toutes les requêtes API vers les fichiers PHP correspondants
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ $1.php [L,QSA]

# Gérer les requêtes OPTIONS pour CORS
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ - [R=200,L]

# Headers CORS pour Apache (si PHP ne les envoie pas)
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-CSRF-Token, X-2FA-Token"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

# Désactiver la signature du serveur
ServerSignature Off
