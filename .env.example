# =============================================================================
# DABA - CONFIGURATION ENVIRONNEMENT (EXEMPLE / TEMPLATE)
# =============================================================================
# Dupliquez ce fichier en .env pour le local, ou renseignez ces variables
# dans le dashboard de vos hébergeurs (Render, Vercel, Supabase).
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONNEMENT & URLs
# -----------------------------------------------------------------------------
# Mode: development | production
APP_ENV=production
APP_DEBUG=false

# URL de l'API Backend (ex: https://daba-pkar.onrender.com)
API_URL=https://daba-pkar.onrender.com

# URL du Frontend (ex: https://daba.vercel.app)
FRONTEND_URL=https://daba.vercel.app

# Origines autorisées pour CORS (séparées par des virgules)
ALLOWED_ORIGINS=https://daba.vercel.app,https://daba.tg,https://www.daba.tg

# -----------------------------------------------------------------------------
# BASE DE DONNÉES (MySQL)
# -----------------------------------------------------------------------------
DB_HOST=votre-hote-mysql.com
DB_PORT=3306
DB_NAME=daba
DB_USER=votre_utilisateur
DB_PASS=votre_mot_de_passe_securise
# Optionnel : certificat SSL MySQL si requis par l'hébergeur
# MYSQL_SSL_CA=/path/to/ca.pem

# -----------------------------------------------------------------------------
# SÉCURITÉ & CLÉS D'API
# -----------------------------------------------------------------------------
# Clé secrète pour les tokens JWT (64 caractères hexadécimaux)
# Générer avec : openssl rand -hex 32
JWT_SECRET=VOTRE_JWT_SECRET_HEX_64_CHARS

# Clé de chiffrement interne pour données sensibles (64 caractères hex)
# Générer avec : openssl rand -hex 32
ENCRYPTION_KEY=VOTRE_ENCRYPTION_KEY_HEX_64_CHARS

# Clé secrète pour les signatures de paiements
# Générer avec : openssl rand -hex 32
PAYMENT_SECRET_KEY=VOTRE_PAYMENT_SECRET_KEY_HEX_64_CHARS

# Clé API pour les commandes externes (n8n / WhatsApp)
# Envoyée dans le header HTTP 'X-API-Key' lors des appels n8n
EXTERNAL_API_KEY=VOTRE_EXTERNAL_API_KEY_N8N_SECURISEE

# -----------------------------------------------------------------------------
# SERVICES EXTERNES (PAIEMENT, EMAILS, FICHIERS)
# -----------------------------------------------------------------------------
# reCAPTCHA v3 (Google)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Stripe (Paiements)
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Emailing (SendGrid ou SMTP)
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=contact@daba.tg
SENDGRID_FROM_NAME=Daba

# Stockage Images (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# -----------------------------------------------------------------------------
# SESSIONS & LIMITATIONS
# -----------------------------------------------------------------------------
SESSION_LIFETIME=900
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=strict
MAX_FILE_SIZE=5242880
MAX_IMAGE_SIZE=2097152
